# Python bytecode / cache
__pycache__/
*.py[cod]

# Build / PyPI (do not commit)
dist/
*.whl
*.egg-info/
*.egg
build/

# Pixi / environment artifacts (pixi.lock committed for CI cache key)
*.lock
!pixi.lock

# Test run artifacts (do NOT commit these)
test/**/artifacts/
.pytest_exitstatus

# Allow reference images to be committed
!test/**/references/

